# ===============================================
# Snaptech AI Platform - Environment Configuration
# ===============================================

# --- Core Backend (Spring Boot 3.3.4) ---
PORT=8081
APP_JWT_SECRET=snaptechSecretKeyForSnaptechSoftwareEngineeringPlatform1234567890!
AI_SERVICE_URL=http://localhost:5000

# Database Configuration
# Default (Local): Embedded H2 file database
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/snaptechdb;AUTO_SERVER=TRUE;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Production (PostgreSQL):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/snaptechdb
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_password

# --- AI & ML Microservice (FastAPI / Python 3.11) ---
AI_PORT=5000

# --- Frontend SPA (React 18) ---
REACT_APP_API_URL=http://localhost:8081/api
REACT_APP_FORCE_FIREBASE=false
