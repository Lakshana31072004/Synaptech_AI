# Synaptech Firebase Configuration for Vercel / Cloud
# Copy these values into your Vercel Project Settings -> Environment Variables

REACT_APP_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=1234567890
REACT_APP_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Optional: Dedicated Spring Boot Backend URL (leave blank if running purely on Firebase)
# REACT_APP_API_URL=https://your-backend-api.onrender.com/api
